# Server
PORT=3000
NODE_ENV=production

# Only needed if the frontend is hosted on a different domain than this
# backend (e.g. a Google Sites page embedding this API). Set it to that
# exact origin, e.g. https://sites.google.com. Leave blank for same-origin.
ALLOWED_ORIGIN=

# Only needed to let another site show this page inside an <iframe>, e.g.
# a Google Sites page using "Embed by URL". Set to that exact origin, e.g.
# https://sites.google.com. Leave blank and no other site can iframe this
# page (default clickjacking protection).
FRAME_ANCESTORS=

# Contact form destination
CONTACT_RECEIVER=manojsairm@gmail.com

# Preferred: Resend (https://resend.com) sends mail over HTTPS, so it works
# on hosts (like Render's free tier) that block outbound SMTP ports.
# Sign up free, create an API key, paste it below. RESEND_FROM can stay as
# the default test sender unless you've verified your own domain on Resend.
RESEND_API_KEY=
RESEND_FROM=MS IT Solutions <onboarding@resend.dev>

# Fallback: SMTP settings, only used if RESEND_API_KEY is blank. Works for
# local dev or hosts that don't block SMTP. If both are left blank,
# submissions still save to data/messages.json and the API still succeeds -
# email sending is just skipped. For Gmail, use an "App Password":
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

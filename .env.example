# Server
PORT=3000
NODE_ENV=production

# Only needed if the frontend is hosted on a different domain than this
# backend (e.g. a Google Sites page embedding this API). Set it to that
# exact origin, e.g. https://sites.google.com. Leave blank for same-origin.
ALLOWED_ORIGIN=

# Contact form destination
CONTACT_RECEIVER=manojsairm@gmail.com

# Optional: SMTP settings to actually email contact-form submissions.
# If left blank, submissions are still saved to data/messages.json and
# the API still responds successfully - email sending is just skipped.
# For Gmail, use an "App Password" (not your normal password):
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
